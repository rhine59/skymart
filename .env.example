SKYMART_DB_HOST=localhost
SKYMART_DB_NAME=skymart
SKYMART_DB_USER=skymart
SKYMART_DB_PASSWORD=change-me

# Public HTTPS origin used to build password-reset links.
SKYMART_PUBLIC_URL=https://example.invalid
# Envelope/header From address. Configure PHP mail transport on the host/container.
SKYMART_MAIL_FROM=no-reply@example.invalid
